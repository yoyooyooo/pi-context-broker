---
title: "交付回执的接受 完成与实际持久化"
---
stateDiagram-v2
  s0: 已准备并选择 尚无交付证明
  state "尚无完整图接受事实" as s1 {
    s2: 等待本次 provider 响应
    s3: provider 未接受#65292;不新增回执
    s4: provider 已接受#65292;图证明不完整
  }
  s5: 操作失效#65292;等待拒绝新证明
  state "已有完整图接受事实" as s6 {
    s7: 2xx 已接受完整固定图
    s8: turn 未完成#65292;保留接受事实
    s9: turn 已完成#65292;尚未持久化
    s10: draft 已返回#65292;等待宿主决定
    s11: 宿主丢弃 draft#65292;仍未持久化
    s12: 公开投影已有回执#65292;等待 ACK
    s13: 等待本次 provider 响应
  }
  s14: 结束#65306;未新增持久化回执
  state "操作已取消或换代" as s15 {
    s16: 等待收口#65306;保留已发生的接受事实
    s17: 结束#65306;保留已发生的接受事实
  }
  state "原分支已离开" as s18 {
    s19: 等待收口#65306;接受事实保留在历史
    s20: 结束#65306;接受事实保留在历史
  }
  s21: 结束#65306;操作失效#65292;未新增证明
  s22: 已观察到实际持久化回执
  s23: draft 未落地 可沿同一固定图重试
  [*] --> s0
  s0 --> s2: 发送选定的 root 与 Requires
  s2 --> s7: 观察响应头与完整图证明
  s2 --> s4: 观察响应头与完整图证明
  s2 --> s3: 观察 turn 结束状态 or 观察响应头与完整图证明
  s3 --> s14: 尝试生成边界 draft#65292;或拒绝
  s7 --> s8: 观察 turn 结束状态
  s7 --> s9: 观察 turn 结束状态
  s8 --> s14: 尝试生成边界 draft#65292;或拒绝
  s5 --> s21: 尝试生成边界 draft#65292;或拒绝
  s4 --> s14: 尝试生成边界 draft#65292;或拒绝
  s9 --> s10: 尝试生成边界 draft#65292;或拒绝
  s16 --> s17: 尝试生成边界 draft#65292;或拒绝 or 核对实际公开投影 or 停止#65292;不声称已持久化
  s19 --> s20: 尝试生成边界 draft#65292;或拒绝 or 停止#65292;不声称已持久化 or 核对实际公开投影
  s10 --> s11: 宿主舍弃 draft
  s10 --> s12: 宿主应用到当前分支
  s11 --> s23: 核对实际公开投影
  s12 --> s22: 核对实际公开投影
  s23 --> s14: 停止#65292;不声称已持久化
  s23 --> s13: 沿原固定组合再次请求
  s13 --> s7: 观察响应头与完整图证明
  s11 --> s14: 核对实际公开投影
  s1 --> s5: 取消 换代或回退
  s6 --> s16: 取消或会话换代
  s6 --> s19: 回退分支
