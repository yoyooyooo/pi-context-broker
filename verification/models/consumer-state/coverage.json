  "models": {
    "FreshnessPublication": {
      "bounds": "Two abstract clock positions (2,3), original validation ticks (1,2,3), one pending request plus one cache return, two generations, two scopes and root/Requires failure targets. Initial prior evidence and the pending ticket are explicit bounded premises.",
      "owners": [
        "consumer-observation.ts currentEvidence/createConsumerObservations.begin/current/accept/observe/deny/canPublish",
        "host-skills.ts observeFailure and graphPreparation",
        "discovery-records.ts recordIdentity"
      ],
      "atomicity": "Receive represents synchronous evidence admission and map publication after asynchronous acquisition; original validation evidence is supplied by the CLI. Clock advances and lifecycle cancellation may interleave before either bounded return. This does not model remote acquisition as atomic.",
      "replays": [
        "consumer-observation.test.ts (original evidence, old cache, same scope, cancellation/generation, child failure)",
        "host-prepare.test.ts F1-F7, exact dependency denial, older success after newer denial"
      ]
    },
    "SelectionGraph": {
      "bounds": "One prior root/Requires vector <1,2>, one replacement <2,1>, one prepare, independent identity/budget checks, one final commit, at most one generation change and cancellation.",
      "owners": [
        "host-skills.ts graphPreparation and its delayed commit",
        "prepare-protocol.ts decodePreparedGraph/decodePreparationLock",
        "session-graph.ts persistSessionSelection/reduceSessionSelection"
      ],
      "atomicity": "Prepare, identity validation, output budget validation and final guarded commit are separate steps. Commit is synchronous. In deferred Pi the approved graph remains staged until the provider hook; this model's selected vector denotes the approved fixed selection, not provider acceptance or durable activation.",
      "replays": [
        "host-prepare.test.ts failed exact-file validation and output budget",
        "session-active.test.ts pending refreshed projection and complete root/Requires vectors",
        "skill-context-session.test.ts graph/projection identity mismatches"
      ]
    },
    "DeliveryBoundary": {
      "bounds": "A previously validated selected root v2/Requires v1 graph; one initial request, at most one retry after discarded drafts, one lifecycle event among cancel/switch/rewind, and one current branch plus its rewind. Full/partial and exact/mismatched identity, response and turn outcomes are finite scenarios.",
      "owners": [
        "host-skills.ts assertPiRun/before_provider_request/after_provider_response/turn_end/acknowledgeProjection",
        "session-active.ts confirmActiveSources",
        "session-source-snapshot.ts sourceBodyLoaded/deferredSourceEntries/withSessionSourceReceipts"
      ],
      "atomicity": "Headers, turn completion, draft return, host apply/drop and later public projection acknowledgement are separate transitions. A 2xx response proves request acceptance and may record active delivery before stream completion. A later failed turn does not erase that historical acceptance. No draft is a persisted projection until observed in the public branch.",
      "replays": [
        "session-active.test.ts selected/partial inactivity, discarded drafts, failed/aborted/late/rewound deliveries",
        "native-read-session.test.ts complete body, scope/pin/hash mismatches"
      ]
    }
  },
