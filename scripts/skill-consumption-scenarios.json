  "coveragePolicy": {
    "default": "not_run",
    "highRisk": "All cache/session variants of activation, refresh, permission, compaction and cancellation are required. No unexecuted tuple becomes passed through pairwise inference.",
    "notApplicable": [
      {
        "rule": "intent=none requires entry=ordinary",
        "reason": "No Skill intent has no explicit Skill entry."
      },
      {
        "rule": "entry=search requires intent=discover",
        "reason": "Search returns candidates; it does not inspect or activate."
      },
      {
        "rule": "entry=ordinary cannot explicitly inspect/use",
        "reason": "Natural requests discover before an explicit inspection/activation; record the subsequent tool entry separately."
      },
      {
        "rule": "entry=dollar/native requires intent=use",
        "reason": "Explicit host activation prepares Required closure; inspection is a separate tool intent."
      },
      {
        "rule": "entry=cli/sdk with resumed host session",
        "reason": "Direct clients have no Pi lifecycle. Test bindings through their host caller separately."
      }
    ]
  },
  "proofLayers": [
    "controlled",
    "real_service",
    "real_model",
    "real_ui",
    "installed_package",
    "cross_machine",
    "daily"
  ]
}
