{
  "name": "context-broker-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.17",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --cwd packages/context-broker typecheck && bun scripts/build-tern.mjs",
    "typecheck": "bun run --cwd packages/context-broker typecheck",
    "check": "bun run build && bun run --cwd packages/context-broker check && bun packages/context-broker/scripts/completion.test.ts",
    "test": "bun run check",
    "test:host": "bun run --cwd packages/context-broker test:host",
    "test:global-config": "bun run --cwd packages/context-broker test:global-config",
    "test:lifecycle": "node packages/context-broker/scripts/context-broker-lifecycle-e2e.mjs",
    "test:artifacts": "node scripts/verify-artifacts.mjs --host omp",
    "test:release": "node --test scripts/release.test.mjs",
    "test:ui": "node scripts/verify-native-ui.mjs",
    "test:model": "node scripts/verify-real-model.mjs",
    "test:source-dependencies": "node scripts/verify-source-dependencies.mjs",
    "pack:dry": "bun scripts/pack.mjs --dry-run",
    "release": "bun scripts/release.ts",
    "release:check": "bun scripts/release.ts --precheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
