      if (delivery.encoding === 'raw') body = span;
      else if (delivery.encoding === 'json') body = JSON.parse('"' + span + '"');
      else if (delivery.encoding === 'xml') body = span.replaceAll('&lt;', '<').replaceAll('&gt;', '>').replaceAll('&amp;', '&');
      else return null;
    } catch { return null; }
