iption":"For a user-requested bounded wait on a resource paths batch only. timeBudgetMs covers the complete operation, including lookup and acquisition; default 30000, maximum 120000. File and byte limits stay unchanged. No automatic retry.","properties":{"timeBudgetMs":{"maximum":120000,"minimum":1,"type":"integer"}},"required":["timeBudgetMs"],"type":"object"},"limit":{"description":"Maximum number of lines to read","type":"number"},"offset":{"description":"Line number to start reading from (1-indexed)","type":"number"},"path":{"description":"Local file path (relative or absolute), an issued skill:// or sr: ref, or a supplied Notion Skill page URL. Notion main reads inspect without adopting task instructions. Copy refs verbatim; never guess filesystem paths.","type":"string"},"paths":{"description":"Copy complete resource refs verbatim from the selected Skill snapshot's resource directory. Every ref must identify a file in the same owner and snapshot. Reads all selected files in one operation without preparing the main body.","items":{"pattern":"^(?:sr:R[A-Za-z0-9_-]{22}|skill:\\/\\/.+)$","type":"string"},"maxItems":16,"minItems":1,"type":"array"},"refresh":{"description":"Use only for a user-requested current-version inspection; a successful complete read needs no follow-up refresh. Keeps the active selection unchanged. Only for a supplied Notion Skill ref in path; fixed resources and local files keep their versions.","type":"boolean"}},"type":"object"}},{"constrainedSampling":{"strict":"prefer","type":"json_schema"},"description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.\n\nCodemode: `tools.bash(args)` resolves to `{ output, truncated, full_output_path?, exit_code, wall_time_seconds }`.","name":"bash","parameters":{"properties":{"command":{"description":"Shell command to execute","type":"string"},"timeout":{"description":"Timeout in seconds (optional, no default timeout)","type":"number"}},"required":["command"],"type":"object"}},{"constrainedSampling":{"strict":"prefer","type":"json_schema"},"description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.\n\nCodemode: `tools.edit(args)` resolves to a string.","name":"edit","parameters":{"properties":{"edits":{"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead.","items":{"properties":{"newText":{"description":"Replacement text for this targeted edit.","type":"string"},"oldText":{"description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call.","type":"string"}},"required":["oldText","newText"],"type":"object"},"type":"array"},"path":{"description":"Path to the file to edit (relative or absolute)","type":"string"}},"required":["path","edits"],"type":"object"}},{"constrainedSampling":{"strict":"prefer","type":"json_schema"},"description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.\n\nCodemode: `tools.write(args)` resolves to a string.","name":"write","parameters":{"properties":{"content":{"description":"Content to write to the file","type":"string"},"path":{"description":"Path to the file to write (relative or absolute)","type":"string"}},"required":["path","content"],"type":"object"}},{"constrainedSampling":{"type":"grammar"