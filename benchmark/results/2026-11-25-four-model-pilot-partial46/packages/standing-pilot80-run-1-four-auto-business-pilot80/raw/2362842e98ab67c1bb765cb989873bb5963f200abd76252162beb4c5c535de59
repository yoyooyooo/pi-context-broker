d Requires together. Members remain candidates. Loading does not authorize executing a workflow. Notion consumption does not write to Notion.","name":"notion_use","parameters":{"additionalProperties":false,"properties":{"ref":{"anyOf":[{"type":"string"},{"items":{"type":"string"},"maxItems":64,"minItems":1,"type":"array"}],"description":"Supplied sr:C/sr:S or skill://<name-or-id>/<main> refs, or exact Notion Skill page URLs for task roots. Requires are included automatically. Prefer returned canonical refs for later actions."},"refresh":{"description":"Explicitly adopt current versions for only these roots after a complete successful load. Existing Requires-only nodes cannot become independent roots through refresh; explicitly use them without refresh first. Accepts the supplied sr:C/sr:S or main ref unchanged, for example {ref:[REF_A,REF_B],refresh:true} for shared roots. Failure keeps the previous selection.","type":"boolean"}},"required":["ref"],"type":"object"},"strict":false,"type":"function"}],"top_logprobs":0,"top_p":0.95,"truncation":"disabled","usage":{"context_details":{"input_tokens":6936,"output_tokens":270},"cost_in_usd_ticks":46716000,"input_tokens":6936,"input_tokens_details":{"cached_tokens":1152},"num_server_side_tools_used":0,"num_sources_used":0,"output_tokens":266,"output_tokens_details":{"reasoning_tokens":115},"total_tokens":7202},"user":null},"sequence_number":13,"type":"response.completed"},"model":"auto/grok-4.7","provider":"[REDACTED_CREDENTIAL]","request_id":"standing-pilot80-run-1-four-auto-business-pilot80-020/request-3"},"episode_id":"standing-pilot80-run-1-four-auto-business-pilot80-020","monotonic_ns":"209706052829625","request_id":"standing-pilot80-run-1-four-auto-business-pilot80-020/request-3","run_id":"standing-pilot80-run-1-four-auto-business-pilot80-020","sequence":224,"stage":"user_task","task_id":"implicit-01-a-n16-r1","turn_id":"turn-1","type":"provider_stream_event","version":1,"wall_time":"2026-11-25T11:08:52.353Z"}
