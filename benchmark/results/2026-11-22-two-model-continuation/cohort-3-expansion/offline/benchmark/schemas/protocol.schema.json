{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "phase": {
      "enum": [
        "phase0",
        "development",
        "pilot",
        "confirmation",
        "regression",
        "screening"
      ]
    },
    "purpose": {
      "enum": [
        "environment_iteration",
        "native_calibration",
        "model_evolution",
        "model_crosssection",
        "model_environment_interaction"
      ]
    },
    "registered_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "allowed_changes": {
      "type": "array",
      "items": {
        "enum": [
          "build",
          "runtime",
          "pi_mode",
          "config",
          "extensions",
          "tools",
          "catalog",
          "sources",
          "native_root",
          "guidance",
          "injection",
          "cache",
          "session",
          "recovery",
          "code_mode",
          "model",
          "return_contract",
          "error_contract"
        ]
      },
      "minItems": 1
    },
    "environments": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/yoyooyooo/pi-context-broker/benchmark/environment-manifest/v1"
      },
      "minItems": 1
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "routing": {
            "type": "object",
            "properties": {
              "mode": { "enum": ["fixed-route", "auto-route"] },
              "model_variant": {
                "type": "string",
                "maxLength": 120,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "reported_model_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "maxLength": 240,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                }
              }
            },
            "required": ["mode", "model_variant", "reported_model_ids"],
            "additionalProperties": false
          },
          "api": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "enum": [
                  "unverified",
                  "verified"
                ]
              },
              "evidence_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "version",
              "verification",
              "evidence_sha256"
            ],
            "additionalProperties": false
          },
          "parameters": {
            "type": "object"
          },
          "backend": {
            "type": "object",
            "properties": {
              "identity": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "observability": {
                "enum": [
                  "reported",
                  "opaque_alias"
                ]
              },
              "window": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "identity",
              "observability",
              "window"
            ],
            "additionalProperties": false
          },
          "adoption": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "as_is",
                  "tuned"
                ]
              },
              "development_budget_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "development_material_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "minItems": 0
              },
              "confirmation_material_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
                },
                "minItems": 0
              }
            },
            "required": [
              "mode",
              "development_budget_id",
              "development_material_ids",
              "confirmation_material_ids"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "family",
          "provider",
          "route",
          "api",
          "adapter",
          "parameters",
          "backend",
          "adoption"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "corpus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
