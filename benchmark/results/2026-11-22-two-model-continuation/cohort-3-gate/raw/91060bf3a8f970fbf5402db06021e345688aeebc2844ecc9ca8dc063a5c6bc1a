`.","name":"tool_search","parameters":{"properties":{"limit":{"description":"Maximum number of tools to return. Defaults to 8.","type":"number"},"query":{"description":"Search query for deferred tools.","type":"string"}},"required":["query"],"type":"object"}},{"description":"Search the authorized Skill metadata directory, including items outside the default View. Returns Skill refs for read or notion_use; it does not load instructions or activate workflows. Use refresh:true to verify discovery after a write or request the latest directory; selected Skill versions stay fixed. Check freshness separately from coverage.\n\nCodemode: `tools.notion_list(args)` resolves to a string.","name":"notion_list","parameters":{"additionalProperties":false,"properties":{"cursor":{"description":"Copy next_cursor to continue the same query and metadata publication; restart after refresh.","type":"string"},"limit":{"description":"Maximum metadata entries, default 20.","maximum":100,"minimum":1,"type":"integer"},"query":{"description":"A short name or description keyword; empty lists the directory.","type":"string"},"refresh":{"description":"Refresh metadata for source, or all configured Notion sources when source is omitted. Keeps task pins; configured offline sources remain offline. Cannot combine with cursor.","type":"boolean"},"source":{"description":"Optional configured source ID to disambiguate directories.","type":"string"}},"required":[],"type":"object"}},{"description":"Load task roots directly to apply their instructions; no preliminary read is needed. Requires load automatically: do not add them as independent roots unless independently requested. To introduce, summarize or inspect a Skill, use read instead. Copy a supplied ref, or pass task roots together. Use refresh:true only for a requested update; the supplied current or fixed main ref locates the same owner's latest version. Refresh roots with conflicting shared Requires together. Members remain candidates. Loading does not authorize executing a workflow. Notion consumption does not write to Notion.","name":"notion_use","parameters":{"additionalProperties":false,"properties":{"ref":{"anyOf":[{"type":"string"},{"items":{"type":"string"},"maxItems":64,"minItems":1,"type":"array"}],"description":"Supplied sr:C/sr:S or skill://<name-or-id>/<main> refs, or exact Notion Skill page URLs for task roots. Requires are included automatically. Prefer returned canonical refs for later actions."},"refresh":{"description":"Explicitly adopt current versions for only these roots after a complete successful load. Existing Requires-only nodes cannot become independent roots through refresh; explicitly use them without refresh first. Accepts the supplied sr:C/sr:S or main ref unchanged, for example {ref:[REF_A,REF_B],refresh:true} for shared roots. Failure keeps the previous selection.","type":"boolean"}},"required":["ref"],"type":"object"}}]},"type":"message_start"},"episode_id":"benchmark-two-model-cohort-3-gate-012","monotonic_ns":"7630181679833","request_id":null,"run_id":"benchmark-two-model-cohort-3-gate-012","sequence":14,"stage":"user_task","task_id":"no-skill-03-a-n16-r1","turn_id":"turn-1","type":"session_event","version":1,"wall_time":"2026-11-23T03:00:55.785Z"}
