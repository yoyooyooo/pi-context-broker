{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "paired_environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "build": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "receipt_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cli": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "source_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "package_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sdk_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "commit",
            "source_sha256",
            "package_sha256",
            "sdk_sha256"
          ],
          "additionalProperties": false
        },
        "broker": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "source_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "package_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "commit",
            "source_sha256",
            "package_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "receipt_sha256",
        "cli",
        "broker"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "node": {
          "type": "object",
          "properties": {
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "entry": {
              "type": "string",
              "pattern": "^(?:/|\\$\\{(?:RUN_ROOT|BUILD_ROOT)\\}/)"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "version",
            "entry",
            "sha256"
          ],
          "additionalProperties": false
        },
        "pi": {
          "type": "object",
          "properties": {
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "entry": {
              "type": "string",
              "pattern": "^(?:/|\\$\\{(?:RUN_ROOT|BUILD_ROOT)\\}/)"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "version",
            "entry",
            "sha256"
          ],
          "additionalProperties": false
        },
        "bun": {
          "type": "object",
          "properties": {
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "entry": {
              "type": "string",
              "pattern": "^(?:/|\\$\\{(?:RUN_ROOT|BUILD_ROOT)\\}/)"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "version",
            "entry",
            "sha256"
          ],
          "additionalProperties": false
        },
        "git": {
          "type": "object",
          "properties": {
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "entry": {
              "type": "string",
              "pattern": "^(?:/|\\$\\{(?:RUN_ROOT|BUILD_ROOT)\\}/)"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "version",
            "entry",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "node",
        "pi",
        "bun"
      ],
      "additionalProperties": false
    },
    "pi": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "broker",
            "native"
          ]
        },
        "entry": {
          "type": "string",
          "pattern": "^(?:/|\\$\\{(?:RUN_ROOT|BUILD_ROOT)\\}/)"
        },
        "config_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "path": {
                "type": "string",
                "pattern": "^(?:/|\\$\\{(?:RUN_ROOT|BUILD_ROOT)\\}/)"
              },
              "role": {
                "enum": [
                  "broker",
                  "observer",
                  "common"
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "path",
              "role",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "description": {
                "type": "string"
              },
              "parameters": {
                "type": "object"
              }
            },
            "required": [
              "name",
              "description",
              "parameters"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "active_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "minItems": 0
        },
        "catalog_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
              },
              "kind": {
                "enum": [
                  "local",
                  "notion",
                  "native"
                ]
              },
              "content_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "content_sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "native_root": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?:/|\\$\\{(?:RUN_ROOT|BUILD_ROOT)\\}/)"
                },
                "content_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "path",
                "content_sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "guidance_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "injection_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "return_contract_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_contract_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "entry_kind": {
          "enum": [
            "pi-cli",
            "pi-sdk"
          ]
        }
      },
      "required": [
        "mode",
        "entry",
        "config_sha256",
        "extensions",
        "tools",
        "active_tools",
        "catalog_sha256",
        "sources",
        "native_root",
        "guidance_sha256",
        "injection_sha256",
        "return_contract_sha256",
        "error_contract_sha256"
      ],
      "additionalProperties": false
    },
    "policies": {
      "type": "object",
      "properties": {
        "cache": {
          "enum": [
            "cold",
            "episode_reuse",
            "warm"
          ]
        },
        "session": {
          "const": "episode_private"
        },
        "recovery": {
          "enum": [
            "none",
            "checkpointed"
          ]
        },
        "code_mode": {
          "enum": [
            "free",
            "off",
            "required"
          ]
        }
      },
      "required": [
        "cache",
        "session",
        "recovery",
        "code_mode"
      ],
      "additionalProperties": false
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "status",
    "paired_environment_id",
    "build",
    "runtime",
    "pi",
    "policies",
    "manifest_sha256"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yoyooyooo/pi-context-broker/benchmark/environment-manifest/v1",
  "description": "A candidate-owned declaration. Hash identities are declared inputs; runtime loading is independently observed."
}
